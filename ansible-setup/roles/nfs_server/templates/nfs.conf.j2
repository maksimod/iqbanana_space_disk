# Файл конфигурации NFS для оптимальной производительности
# Автоматически сгенерирован Ansible {{ ansible_date_time.iso8601 }}

[general]
pipefs-directory=/var/lib/nfs/rpc_pipefs

[nfsd]
# Увеличиваем число потоков NFS сервера для большей производительности
threads=32
# Увеличиваем размер буфера для больших файлов
tcp-buffer-size=8388608
udp-buffer-size=8388608
# Используем ядро NFSv4 для более эффективной работы
vers3=y
vers4=y
vers4.0=y
vers4.1=y
vers4.2=y
# Отключение проверки delegations для повышения производительности
delegate=y
# Максимальное время жизни блокировок
lease-time=120

[mountd]
# Обеспечиваем достаточное количество потоков для монтирования
threads=16
cache-use-retired-count=y

[statd]
port=32765
outgoing-port=32766

[lockd]
port=32768
udp-port=32768
# Количество потоков для обработки блокировок
nlm-grace-period=20
# Кэширование блокировок
nlm-udp-slot-table-entries=256
nlm-tcp-slot-table-entries=256

[sm-notify]
outgoing-port=32769

# Оптимизации для больших файлов и высокой нагрузки
[nfs]
server-threads=32
nfs4-grace=120
udp=n
tcp=y
# Асинхронные операции I/O
max-read-delegation-lifetime=3600
# Для больших файлов
rdma=n
# Кэширование данных на клиенте
cache-max-size=16777216
# Увеличиваем ограничения памяти для буферов
mount-reserve=262144

# Настройки клиента NFS
[client-side]
enable-ino64=y