# Файл конфигурации NFS для оптимальной производительности
# Автоматически сгенерирован Ansible {{ ansible_date_time.iso8601 }}

[general]
pipefs-directory=/var/lib/nfs/rpc_pipefs

[nfsd]
# Потоки NFS сервера оптимизированы для системы с 1 ядром
threads=8
# Оптимальные размеры буфера для 1GB RAM
tcp-buffer-size=8388608
udp-buffer-size=8388608
# Используем ядро NFSv4 для более эффективной работы
vers3=y
vers4=y
vers4.0=y
vers4.1=y
vers4.2=y
# Включаем делегирование для повышения производительности
delegate=y
# Оптимальное время жизни блокировок
lease-time=90

[mountd]
# Обеспечиваем достаточное количество потоков для монтирования
threads=4
cache-use-retired-count=y

[statd]
port=32765
outgoing-port=32766

[lockd]
port=32768
udp-port=32768
# Оптимизировано для 1 ядра
nlm-grace-period=30
# Кэширование блокировок - оптимизировано для 1GB RAM
nlm-udp-slot-table-entries=64
nlm-tcp-slot-table-entries=64

[sm-notify]
outgoing-port=32769

# Оптимизации для больших файлов и системы с ограниченными ресурсами
[nfs]
server-threads=8
nfs4-grace=30
udp=n
tcp=y
# Оптимальный размер кэша для 1GB RAM
cache-max-size=33554432

# Настройки клиента NFS
[client-side]
enable-ino64=y