// Конфигурация приложения с оптимизацией для высокоскоростной передачи файлов
const config = {
  // Базовые настройки
  server: {
    port: process.env.PORT || 6005,
    allowedOrigins: [
      'http://46.35.241.37:6001', 
      'http://localhost:6001',
      'https://iqbanana.online',
      'http://iqbanana.online'
    ]
  },
  
  // Версия API
  apiVersion: 'v1',
  
  // Пути к смонтированным дискам на веб-сервере
  disks: {
{% for disk in storage_disks %}
    '{{ disk.device | regex_replace('/dev/', 'disk_') }}': '{{ nfs_mount_base }}/{{ disk.mountpoint }}'{% if not loop.last %},{% endif %}
{% endfor %}
  },
  
  // Настройки производительности для файловых операций
  performance: {
    // Увеличен размер чанка до 20MB для ускорения передачи больших файлов
    chunkSize: 20 * 1024 * 1024,
    
    // Увеличено число одновременных загрузок для максимальной загрузки канала
    concurrentUploads: 16,
    
    // 20GB максимальный размер файла
    maxFileSize: 20 * 1024 * 1024 * 1024,
    
    // Включаем асинхронные файловые операции для неблокирующей работы
    asyncFileOperations: true,
    
    // Используем worker threads для обработки файлов параллельно
    useWorkers: true,
    
    // Увеличенный размер буфера для потоковой обработки (8MB)
    bufferSize: 8 * 1024 * 1024,
    
    // Оптимизация для скорости - приоритет производительности над другими факторами
    optimizeForSpeed: true,
    
    // Увеличение таймаута загрузки до 10 минут для больших файлов
    uploadTimeout: 600000,
    
    // Поддержка постоянного соединения для снижения накладных расходов на установку соединения
    keepAliveRequests: true,
    
    // Обработка файлов в фоне - не блокирует интерфейс
    backgroundProcessing: true,
    
    // Использовать килобайты вместо мегабайтов в df для точности
    useDfKiloBytes: true,
    
    // Дополнительные оптимизации для высокоскоростной передачи
    
    // Кэширование метаданных файлов для снижения нагрузки на файловую систему
    metadataCaching: true,
    
    // Кэш для часто используемых файлов
    fileCache: true,
    
    // Максимальный размер кэша (512MB)
    maxCacheSize: 512 * 1024 * 1024,
    
    // Предварительная загрузка для ускорения доступа
    preloading: true,
    
    // Использование потоков для обработки данных
    useStreams: true,
    
    // Оптимизация для сетевой передачи
    networkOptimization: {
      // Включаем HTTP/2 для мультиплексирования запросов
      useHttp2: true,
      
      // Использование сжатия данных при передаче
      compression: true,
      
      // Количество повторных попыток при сбоях
      maxRetries: 5,
      
      // Интервал между повторными попытками (в мс)
      retryInterval: 1000,
      
      // Экспоненциальное увеличение интервала между повторами
      useBackoff: true
    },
    
    // Настройки для оптимизации работы с NFS
    nfsOptimization: {
      // Использование прямого доступа к файлам
      directIO: true,
      
      // Предварительное чтение для ускорения доступа
      readAhead: 16384,
      
      // Опции для синхронизации на диск
      syncMode: 'async',
      
      // Задержка синхронизации для группировки операций записи (мс)
      syncDelay: 5000
    }
  }
};

module.exports = config;