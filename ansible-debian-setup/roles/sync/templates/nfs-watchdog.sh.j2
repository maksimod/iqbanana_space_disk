#!/bin/bash

# Настройки
REMOTE_IP="192.168.0.104"
MOUNT_PREFIX="/mnt"
LOG_FILE="/var/log/nfs-watchdog.log"
TRIGGER_FILE="/tmp/nfs_trigger"

# Функция для логирования
log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_FILE"
}

# Создаём лог-файл с правильными правами, если его нет
mkdir -p /var/log
touch "$LOG_FILE"
sudo chown apper:apper "$LOG_FILE"
sudo chmod 644 "$LOG_FILE"

# Проверка доступности NFS сервера
if ! ping -c 2 -w 3 $REMOTE_IP >/dev/null 2>&1; then
    log "ПРЕДУПРЕЖДЕНИЕ: Сервер $REMOTE_IP недоступен"
    exit 0
fi

# Проверка состояния NFS монтирований
failed_mounts=0
total_mounts=0

# Находим все NFS монтирования в /etc/fstab
while read -r line; do
    if [[ "$line" == *"$REMOTE_IP:"* && "$line" == *"nfs"* ]]; then
        mount_point=$(echo "$line" | awk '{print $2}')
        total_mounts=$((total_mounts + 1))
        
        # Проверка точки монтирования
        if ! mountpoint -q "$mount_point"; then
            log "ОШИБКА: $mount_point не смонтирован"
            failed_mounts=$((failed_mounts + 1))
        else
            # Проверка доступа к точке монтирования
            if ! timeout 5 ls -la "$mount_point" &>/dev/null; then
                log "ОШИБКА: $mount_point не отвечает"
                failed_mounts=$((failed_mounts + 1))
            fi
        fi
    fi
done < /etc/fstab

# Если обнаружены проблемы, создаем триггер для перемонтирования
if [ $failed_mounts -gt 0 ]; then
    log "Обнаружено $failed_mounts проблемных монтирований из $total_mounts"
    touch "$TRIGGER_FILE"
    
    # Принудительно размонтируем проблемные точки
    for mount in $(mount | grep "type nfs" | grep "$MOUNT_PREFIX" | awk '{print $3}'); do
        if ! timeout 5 ls -la "$mount" &>/dev/null; then
            log "Принудительное размонтирование $mount"
            sudo umount -f -l "$mount" 2>/dev/null
        fi
    done
    
    # Запускаем скрипт монтирования
    log "Запуск скрипта повторного монтирования..."
    sudo /home/apper/mount-nfs.sh
else
    log "Все NFS монтирования ($total_mounts шт.) в порядке"
fi

exit 0 