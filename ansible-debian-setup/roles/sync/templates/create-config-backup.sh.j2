#!/bin/bash

# Переменные
CONFIG_FILE="/home/apper/iqbanana-disk/backend/config/config.js"
LOG_FILE="/var/log/config-backups.log"
MAX_BACKUPS_PER_DAY=24 # Хранить не более 24 бэкапов в день (1 в час)

# Функция для логирования
log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_FILE"
}

# Создаём лог-файл с правильными правами, если его нет
mkdir -p /var/log
touch "$LOG_FILE"
sudo chown apper:apper "$LOG_FILE"
sudo chmod 644 "$LOG_FILE"

# Проверяем, существует ли файл конфигурации
if [ ! -f "$CONFIG_FILE" ]; then
    log "ОШИБКА: Файл конфигурации $CONFIG_FILE не найден"
    exit 1
fi

# Текущая дата/время
CURRENT_DATE=$(date '+%Y%m%d')
CURRENT_HOUR=$(date '+%H')
TIMESTAMP=$(date '+%Y%m%d%H%M%S')

# Проверяем, существует ли уже бэкап для текущего часа
HOUR_BACKUPS=$(find "$(dirname "$CONFIG_FILE")" -name "$(basename "$CONFIG_FILE").backup.${CURRENT_DATE}${CURRENT_HOUR}*" -type f | wc -l)

if [ "$HOUR_BACKUPS" -gt 0 ]; then
    log "Бэкап для часа $CURRENT_HOUR уже существует, пропускаем создание"
else
    # Создаем резервную копию
    cp "$CONFIG_FILE" "${CONFIG_FILE}.backup.${TIMESTAMP}"
    log "Создан бэкап: ${CONFIG_FILE}.backup.${TIMESTAMP}"
    
    # Удаляем старые бэкапы, оставляя только последние MAX_BACKUPS_PER_DAY
    BACKUP_COUNT=$(find "$(dirname "$CONFIG_FILE")" -name "$(basename "$CONFIG_FILE").backup.*" -type f | wc -l)
    if [ "$BACKUP_COUNT" -gt "$MAX_BACKUPS_PER_DAY" ]; then
        EXCESS_COUNT=$((BACKUP_COUNT - MAX_BACKUPS_PER_DAY))
        OLD_BACKUPS=$(find "$(dirname "$CONFIG_FILE")" -name "$(basename "$CONFIG_FILE").backup.*" -type f | sort | head -n "$EXCESS_COUNT")
        echo "$OLD_BACKUPS" | xargs rm -f
        log "Удалено $EXCESS_COUNT старых бэкапов"
    fi
fi

log "Завершено выполнение скрипта создания бэкапов"
exit 0 