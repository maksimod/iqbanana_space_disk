# /etc/exports - NFS exports configuration, автоматически создан Ansible
# 
# Пример настройки:
# /srv/nfs  192.168.1.0/24(rw,async,no_subtree_check,no_wdelay)
#
# Оптимизированные настройки для всех обнаруженных дисков:
# - async: асинхронные операции записи для повышения производительности
# - no_wdelay: без задержек записи для повышения скорости
# - no_subtree_check: отключение проверки поддиректорий для повышения производительности
# - no_root_squash: разрешение root доступа для администрирования

{% for disk in nfs_disks %}
{{ disk.mount_point }} {{ apper_ip }}(rw,async,no_subtree_check,no_root_squash,no_wdelay,insecure)
{% endfor %} 